{
  "title": "API Gateway - Logs Overview",
  "refresh": "10s",
  "panels": [
    {
      "title": "Log Volume (5m)",
      "type": "stat",
      "query": "sum(count_over_time({service_name=~\".+\"}[5m]))"
    },
    {
      "title": "Errors (5m)",
      "type": "stat",
      "query": "sum(count_over_time({service_name=~\".+\"} | json | level=\"error\" [5m]))"
    },
    {
      "title": "Warnings (5m)",
      "type": "stat",
      "query": "sum(count_over_time({service_name=~\".+\"} | json | level=\"warning\" [5m]))"
    },
    {
      "title": "Dependency Failures (5m)",
      "type": "stat",
      "query": "sum(count_over_time({service_name=~\".+\"} | json | event=~\"redis_unreachable|db_unreachable|db_pool_exhausted\" [5m]))"
    },
    {
      "title": "Logs by Level",
      "type": "timeseries",
      "query": "sum by(level) (count_over_time({service_name=~\".+\"} | json [5m]))"
    },
    {
      "title": "Logs by Service",
      "type": "timeseries",
      "query": "sum by(service_name) (count_over_time({service_name=~\".+\"}[5m]))"
    },
    {
      "title": "Recent Errors & Warnings",
      "type": "logs",
      "query": "{service_name=~\".+\"} | json | level=~\"error|warning\""
    },
    {
      "title": "All Logs",
      "type": "logs",
      "query": "{service_name=~\".+\"}"
    }
  ]
}